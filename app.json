{
  "expo": {
    "name": "PantryLens",
    "slug": "pantrylens",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "pantrylens",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.pantrylens.app"
    },
    "android": {
      "package": "org.pantrylens.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "PantryLens uses your photos to read donation labels and count items.",
          "cameraPermission": "PantryLens uses the camera to photograph donations and read their labels."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PantryLens uses the camera to read the barcode on a package and identify it exactly."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing"
    ]
  }
}
